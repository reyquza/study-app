# Copy to backend/.env and fill in. Never commit the real file.

# Local default is SQLite at backend/nextlearn.db. Use a Postgres URL in production.
# DATABASE_URL=sqlite:///./nextlearn.db
# DATABASE_URL=postgresql://user:password@host:5432/nextlearn

# Set to "production" when deployed (enables Secure cookies). RENDER=true also counts.
# APP_ENV=production
APP_TIMEZONE=Asia/Tokyo

# Comma-separated Google accounts allowed to sign in. (WHITELISTS is still read as a fallback.)
ALLOWED_EMAILS=you@example.com

# Firebase Admin service account: a file path (default backend/firebase-credentials.json) ...
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# ... or the JSON itself, for hosts without secret files.
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# DAILY_GRADING_LIMIT=5

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origins of a separate frontend (the planned Next.js app) allowed to call /api/*.
# FRONTEND_ORIGINS=http://localhost:3000
