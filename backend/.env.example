# Copy to backend/.env and fill in. Never commit the real file.

# Local default is SQLite at backend/nextlearn.db. Use a Postgres URL in production.
# DATABASE_URL=sqlite:///./nextlearn.db
# DATABASE_URL=postgresql://user:password@host:5432/nextlearn

# Set to "production" when deployed (enables Secure cookies). RENDER=true also counts.
# APP_ENV=production
APP_TIMEZONE=Asia/Tokyo

# Signs session cookies. Required in production; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# DAILY_GRADING_LIMIT=5
# GLOBAL_DAILY_GRADING_LIMIT=300

# The grading worker runs inside the web process by default. To run it separately
# (python -m app.worker), set this to false on the web service.
# RUN_WORKER_IN_PROCESS=true
# WORKER_CONCURRENCY=4

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origins of a separate frontend (the planned Next.js app) allowed to call /api/*.
# FRONTEND_ORIGINS=http://localhost:3000
